# ---------------------------------------------------------------------------
# SentinelAI environment contract
# Copy to `.env` (never commit it) and adjust as needed.
# ---------------------------------------------------------------------------

# OpenAI key used by the LangGraph investigation agent and the Data Copilot.
# Leave empty to keep the deterministic offline engine running.
OPENAI_API_KEY=

# `true`  -> fully offline deterministic engine (real SQLite forensics, no LLM).
# `false` -> live OpenAI agent (requires OPENAI_API_KEY).
# Defaults to true so the demo runs with zero credentials.
SENTINEL_MOCK_MODE=true

# Optional overrides --------------------------------------------------------
# Path to the SQLite database file (defaults to <project root>/sentinel.db)
# SENTINEL_DB_PATH=sentinel.db

# Base URL the Streamlit UI uses to reach the FastAPI backend
# SENTINEL_API_URL=http://localhost:8000

# Seed the baseline on API start-up when the database is empty
# SENTINEL_AUTO_SEED=true

# Transform SQL file the demo reads/rewrites (point outside the repo to keep git clean)
# SENTINEL_TRANSFORM_SQL_PATH=sql/transform_daily_customers.sql

# Model routing for live mode
# SENTINEL_AGENT_MODEL=gpt-4o-mini
# SENTINEL_COPILOT_MODEL=gpt-4o-mini
